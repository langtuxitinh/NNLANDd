        <form id="homeSearchForm" action="<c:url value='/trang-chu'/>" method="get">
            <div class="search">
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-md-3">
                            <div class="search-item">
                                <p class="search-text">Chọn tỉnh/thành phố</p>
                                <select class="search-option" name="province" id="searchProvince" aria-label="Chọn tỉnh/thành phố">
                                    <option value="">- Tỉnh/thành phố</option>
                                    <c:forEach var="p" items="${provinces}">
                                        <option value="${p.key}"<c:if test="${p.key == selectedProvince}"> selected</c:if>>${p.value}</option>
                                    </c:forEach>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="search-item">
                                <p class="search-text">Chọn quận/huyện</p>
                                <select class="search-option" name="district" id="searchDistrict"
                                        data-selected="${selectedDistrict}" aria-label="Chọn quận/huyện">
                                    <option value="">--Chọn quận/huyện--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="search-item">
                                <p class="search-text">Chọn loại bất động sản</p>
                                <select class="search-option" name="typeCode" id="searchType" aria-label="Chọn loại bất động sản">
                                    <option value="">- Loại bất động sản</option>
                                    <c:forEach var="t" items="${typeCodes}">
                                        <option value="${t.key}"<c:if test="${t.key == selectedType}"> selected</c:if>>${t.value}</option>
                                    </c:forEach>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-3 ">
                            <div class="search-btn">
                                <button type="submit" class="search-btn-text">
                                    <i class="bi bi-search search-btn-icon"></i>
                                    <span>Tìm kiếm nhanh</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <script>
            // Ô quận/huyện đổi theo tỉnh/thành đã chọn (không dùng jQuery vì jQuery nạp ở cuối trang)
            (function () {
                var districtsByProvince = {
                    <c:forEach var="entry" items="${districtsByProvince}" varStatus="st">
                    "${entry.key}": [
                        <c:forEach var="d" items="${entry.value}" varStatus="ds">{"code": "${d.key}", "name": "${d.value}"}${ds.last ? '' : ','}
                        </c:forEach>
                    ]${st.last ? '' : ','}
                    </c:forEach>
                };
                var provinceSelect = document.getElementById('searchProvince');
                var districtSelect = document.getElementById('searchDistrict');

                function fillDistricts(provinceCode, selectedCode) {
                    districtSelect.innerHTML = '';
                    var first = document.createElement('option');
                    first.value = '';
                    first.textContent = provinceCode ? '--Chọn quận/huyện--' : '--Chọn tỉnh/thành trước--';
                    districtSelect.appendChild(first);
                    (districtsByProvince[provinceCode] || []).forEach(function (d) {
                        var option = document.createElement('option');
                        option.value = d.code;
                        option.textContent = d.name;
                        if (d.code === selectedCode) {
                            option.selected = true;
                        }
                        districtSelect.appendChild(option);
                    });
                    districtSelect.disabled = !provinceCode;
                }

                provinceSelect.addEventListener('change', function () {
                    fillDistricts(provinceSelect.value, '');
                });
                fillDistricts(provinceSelect.value, districtSelect.getAttribute('data-selected'));

                <c:if test="${searched}">
                // Sau khi tìm kiếm, cuộn thẳng tới phần kết quả
                var resultBox = document.getElementById('ket-qua');
                if (resultBox) {
                    resultBox.scrollIntoView();
                }
                </c:if>
            })();
        </script>
